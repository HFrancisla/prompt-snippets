{
  "name": "@hfrancisla/pi-prompt-snippets",
  "version": "0.1.0",
  "type": "module",
  "description": "Opt-in Markdown prompt snippets for Pi with once/sticky modes and Skill support",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm test",
    "prepack": "npm run verify"
  },
  "license": "MIT",
  "author": "Francisla.H <hfrancisla@gmail.com>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt-snippets",
    "skills",
    "tui"
  ],
  "files": [
    "index.ts",
    "core.ts",
    "snippets",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "TESTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HFrancisla/prompt-snippets.git"
  },
  "homepage": "https://github.com/HFrancisla/prompt-snippets#readme",
  "bugs": {
    "url": "https://github.com/HFrancisla/prompt-snippets/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
